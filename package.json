{
  "name": "pretti-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Personal extensions for Pi Coding Agent",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "test:web-search": "node --test test/openai-web-search/*.test.mjs",
    "typecheck:web-search": "tsc -p extensions/openai-web-search/tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
